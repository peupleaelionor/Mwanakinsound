# ============================================================
#  MWANAKIN SOUND — Environment variables
#  Copy to `.env.local` for development. NEVER commit real secrets.
# ============================================================

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server-only, NEVER expose to the browser) ---
# Used by Edge Functions / server actions for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string for `npm run db:*` scripts.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mwanakin Sound

# --- Cloudflare R2 (audio-master storage, server-only) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUDIO_MASTER=mwanakin-audio-master
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.mwanakinsound.com

# --- AI layer (server-only; used by Edge Functions) ---
# Provider-agnostic. See features/ai for the abstraction.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=mwanakinsound.com
