# ============================================================
#  kinshasa-beats (Vite/React) — variables d'environnement
#  Copier en `.env` (ou `.env.local`). NE JAMAIS committer de vrais secrets.
# ============================================================

# --- Supabase (exposé au navigateur — préfixe VITE_) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- App ---
VITE_SITE_URL=http://localhost:5173
VITE_APP_NAME=Mwanakin Sound

# --- Storage/CDN (optionnel, audio master via R2/CDN) ---
VITE_R2_PUBLIC_URL=

# ⚠️ NE JAMAIS mettre la service_role ici : tout ce qui est préfixé VITE_ est
# embarqué dans le bundle navigateur. Les opérations privilégiées (billing,
# webhooks paiement, IA) passent par des Supabase Edge Functions où
# SUPABASE_SERVICE_ROLE_KEY reste strictement côté serveur.
